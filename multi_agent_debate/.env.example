# Configuration pour le Système Multi-Agent de Débat

# ===========================================
# OPTION 1 : DeepSeek (Recommandé - Moins cher)
# ===========================================
OPENAI_API_KEY=sk-your-deepseek-api-key-here
OPENAI_API_BASE=https://api.deepseek.com

# ===========================================
# OPTION 2 : OpenAI (GPT-4, GPT-3.5)
# ===========================================
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_API_BASE=https://api.openai.com/v1

# ===========================================
# OPTION 3 : Azure OpenAI
# ===========================================
# OPENAI_API_KEY=your-azure-api-key
# OPENAI_API_BASE=https://your-resource.openai.azure.com
# OPENAI_API_VERSION=2024-02-15-preview

# ===========================================
# Configuration Optionnelle
# ===========================================

# Modèle à utiliser (exemples)
# MODEL_NAME=deepseek-chat        # Pour DeepSeek
# MODEL_NAME=gpt-4                # Pour OpenAI GPT-4
# MODEL_NAME=gpt-3.5-turbo        # Pour OpenAI GPT-3.5

# Température (0.0 = déterministe, 1.0 = créatif)
# TEMPERATURE=0.7

# Niveau de verbosité (0, 1, 2)
# VERBOSE=2

# Répertoire de sortie
# OUTPUT_DIR=output
