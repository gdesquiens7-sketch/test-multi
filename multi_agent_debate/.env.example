# Configuration pour le Système Multi-Agent de Débat

# ===========================================
# OPTION 1 : OpenRouter (RECOMMANDÉ - Accès à tous les LLM)
# ===========================================
# OpenRouter donne accès à DeepSeek, GPT-4, Claude, Llama, etc. avec une seule clé
# Créez un compte gratuit sur : https://openrouter.ai/
OPENAI_API_KEY=sk-or-v1-your-openrouter-api-key-here
OPENAI_API_BASE=https://openrouter.ai/api/v1

# ===========================================
# OPTION 2 : DeepSeek Direct
# ===========================================
# OPENAI_API_KEY=sk-your-deepseek-api-key-here
# OPENAI_API_BASE=https://api.deepseek.com

# ===========================================
# OPTION 3 : OpenAI (GPT-4, GPT-3.5)
# ===========================================
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_API_BASE=https://api.openai.com/v1

# ===========================================
# OPTION 4 : Azure OpenAI
# ===========================================
# OPENAI_API_KEY=your-azure-api-key
# OPENAI_API_BASE=https://your-resource.openai.azure.com
# OPENAI_API_VERSION=2024-02-15-preview

# ===========================================
# Configuration Optionnelle
# ===========================================

# Modèle à utiliser (exemples)
# Pour OpenRouter (format: provider/model-name)
MODEL_NAME=deepseek/deepseek-chat           # DeepSeek via OpenRouter (recommandé, pas cher)
# MODEL_NAME=anthropic/claude-3.5-sonnet    # Claude 3.5 Sonnet
# MODEL_NAME=openai/gpt-4                   # GPT-4
# MODEL_NAME=openai/gpt-3.5-turbo           # GPT-3.5 Turbo
# MODEL_NAME=meta-llama/llama-3.1-70b       # Llama 3.1 70B
# MODEL_NAME=google/gemini-pro              # Gemini Pro

# Pour DeepSeek Direct
# MODEL_NAME=deepseek-chat

# Pour OpenAI Direct
# MODEL_NAME=gpt-4
# MODEL_NAME=gpt-3.5-turbo

# Température (0.0 = déterministe, 1.0 = créatif)
# TEMPERATURE=0.7

# Note: Le paramètre VERBOSE n'est plus utilisé dans CrewAI 0.98.0
# La verbosité est hardcodée dans debate_crew.py (verbose=True)
# Pour la désactiver, modifiez directement debate_crew.py ligne 132
